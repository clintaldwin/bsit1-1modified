{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sectionlobby.app/schemas/v1/import.schema.json",
  "title": "Section Lobby Import Batch Schema",
  "description": "Strict JSON schema specification for academic section import batches, covering announcements, assignments, tasks, notes, events, and resources.",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version, strictly '1.0'"
    },
    "source_text": {
      "type": "string",
      "description": "Optional original raw conversation or document snippet"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ImportItem"
      }
    }
  },
  "definitions": {
    "PriorityLevel": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"]
    },
    "AnnouncementData": {
      "type": "object",
      "required": ["title", "content"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "content": { "type": "string", "minLength": 3 },
        "priority": { "$ref": "#/definitions/PriorityLevel" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "AssignmentData": {
      "type": "object",
      "required": ["subject", "title", "description", "due_at"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string" },
        "due_at": { "type": "string", "format": "date-time" },
        "priority": { "$ref": "#/definitions/PriorityLevel" }
      }
    },
    "TaskData": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string" },
        "assigned_to": { "type": "string" },
        "due_at": { "type": "string", "format": "date-time" },
        "priority": { "$ref": "#/definitions/PriorityLevel" }
      }
    },
    "NoteData": {
      "type": "object",
      "required": ["title", "content"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "content": { "type": "string", "minLength": 3 },
        "subject": { "type": "string" },
        "author": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "EventData": {
      "type": "object",
      "required": ["title", "starts_at"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string" },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "location": { "type": "string" }
      }
    },
    "ResourceData": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "category": { "type": "string" }
      }
    },
    "AnnouncementItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["announcement"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/AnnouncementData" }
      }
    },
    "AssignmentItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["assignment"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/AssignmentData" }
      }
    },
    "TaskItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["task"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/TaskData" }
      }
    },
    "NoteItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["note"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/NoteData" }
      }
    },
    "EventItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["event"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/EventData" }
      }
    },
    "ResourceItem": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["resource"] },
        "source_text": { "type": "string" },
        "data": { "$ref": "#/definitions/ResourceData" }
      }
    },
    "ImportItem": {
      "oneOf": [
        { "$ref": "#/definitions/AnnouncementItem" },
        { "$ref": "#/definitions/AssignmentItem" },
        { "$ref": "#/definitions/TaskItem" },
        { "$ref": "#/definitions/NoteItem" },
        { "$ref": "#/definitions/EventItem" },
        { "$ref": "#/definitions/ResourceItem" }
      ]
    }
  }
}
